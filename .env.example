# Copy to .env and fill in. Never commit .env — it holds real credentials.

NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# MongoDB. Local for dev; an Atlas SRV string for staging/production.
MONGODB_URI=mongodb://127.0.0.1:27017/sugarloop

# Signing secrets. Generate with: openssl rand -base64 48
# Customer and staff tokens are signed with DIFFERENT secrets, so a leaked
# customer token can never be replayed against a staff endpoint.
JWT_CUSTOMER_SECRET=replace-me-customer
JWT_STAFF_SECRET=replace-me-staff

# Customer sessions last 4 days (the agreed OTP re-verification window).
JWT_CUSTOMER_EXPIRES_IN=4d
JWT_STAFF_ACCESS_EXPIRES_IN=15m
JWT_STAFF_REFRESH_EXPIRES_IN=7d

LOG_LEVEL=debug

# --- Phone verification -----------------------------------------------------
# How OTP codes reach a customer.
#   log        prints the code to this server's console and sends NOTHING. The only
#              transport that works with no third-party account. REFUSED in production.
#   whatsapp   needs a Meta Business account + an approved `sugarloop_otp` template
#   sms        needs a Twilio account
OTP_TRANSPORT=log

# --- Order notifications ----------------------------------------------------
# How order updates reach customers and branches. Six Utility-category templates:
# sugarloop_order_placed, _out_for_delivery, _ready_for_pickup, _order_completed,
# _new_order_staff, _enquiry_staff.
#
# Separate from OTP_TRANSPORT on purpose. Meta approves each template on its own and
# rejections are common, so `sugarloop_otp` (Authentication category) can clear review
# while an order template is still on its second submission — one switch would mean
# holding back a working OTP flow until the slowest template lands.
#
#   log        renders the message to this console and sends NOTHING. REFUSED in
#              production, where it means customers never hear their order was placed
#              and — worse — the branch never hears an order came in.
#   whatsapp   needs the Meta Business account and all six templates approved
NOTIFY_TRANSPORT=log

# Where the WhatsApp copy of a corporate enquiry goes. Left empty, that message is
# skipped and logged; the notification EMAIL is unaffected either way.
# ENQUIRY_NOTIFY_PHONE=+923001234567

# --- Redis (rate limits + the order escalation queue) -----------------------
# OPTIONAL. Without it the API runs exactly as before, with two caveats:
#
#   1. Rate limits become per-process and reset on every restart. On OTP that matters —
#      the per-IP cap IS the control stopping a script walking six-digit codes.
#   2. Unacknowledged orders are NOT chased. An order nobody opens sits in `placed`
#      until a customer rings to ask where it is.
#
# Both are fine for one developer on a laptop and wrong for a real shop, so both warn
# loudly at boot outside development.
# REDIS_URL=redis://127.0.0.1:6379

# How long an order may sit unacknowledged before each rung is chased. Client decision.
ORDER_ESCALATION_MANAGER_MINUTES=5
ORDER_ESCALATION_ADMIN_MINUTES=10

# Who the second rung reaches. A StaffUser has no phone field, so this cannot be looked
# up. Falls back to ENQUIRY_NOTIFY_PHONE; empty means the admin chase is logged and
# skipped rather than sent to a guessed number.
# ADMIN_ESCALATION_PHONE=+923001234567

# --- Geocoding --------------------------------------------------------------
# Turns a typed delivery address into coordinates, to pick the nearest branch.
#   nominatim  OpenStreetMap. Free, no key, works today. Rate-limited to ~1 req/s and
#              weak on specific Pakistani buildings — it knows "DHA Phase 2" but not
#              "Nadir Arcade". Fine for development, a stand-in for production.
#   google     the intended provider. Needs GOOGLE_MAPS_API_KEY below.
GEOCODER=nominatim

# Google Cloud > APIs & Services > Credentials, with the Geocoding API enabled and
# billing switched on. 10,000 lookups/month are free, then $5 per 1,000 — and results
# are cached here for 90 days, so repeat addresses cost nothing.
#
# RESTRICT THE KEY to the Geocoding API, and to your server's IP. An unrestricted key
# that leaks is billed to the client until somebody notices.
# The server refuses to start with GEOCODER=google and no key.
# GOOGLE_MAPS_API_KEY=

# --- Email ------------------------------------------------------------------
# How outbound email leaves the server. Today that means corporate gifting enquiries.
#   log    prints the whole message to this console and sends NOTHING. REFUSED in
#          production, where it would silently drop every lead.
#   smtp   real delivery. Needs the four SMTP_* values below.
#
# Unlike WhatsApp, this one is not blocked on anything: the shop already has
# sugarlooppk@gmail.com, and Gmail issues an app password in about two minutes
# (Google Account > Security > 2-Step Verification > App passwords). Use that app
# password below, NOT the account's real password.
EMAIL_TRANSPORT=log

# Gmail: smtp.gmail.com / 587. The server refuses to start with EMAIL_TRANSPORT=smtp
# and any of host, user or password missing.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=sugarlooppk@gmail.com
# SMTP_PASSWORD=

# The From: address. Must be one the SMTP account is allowed to send as.
# EMAIL_FROM=Sugarloop <sugarlooppk@gmail.com>

# Where corporate gifting enquiries are emailed.
# ENQUIRY_NOTIFY_EMAIL=sugarlooppk@gmail.com

# Used by `npm run seed` only — the API never reads it. Required to seed staff
# outside development; in development the script generates one and prints it once.
# SEED_ADMIN_PASSWORD=
